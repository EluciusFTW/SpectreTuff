<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>SpectreTuff.Elmish</RootNamespace>
    <LangVersion>latest</LangVersion>
    <Authors>Guy Buss, Daniel Muckelbauer</Authors>
    <Copyright>Guy Buss, Daniel Muckelbauer</Copyright>
    <Title>SpectreTuff.Elmish - Elmish integration for SpectreTuff</Title>
    <Description>Run Elmish applications on SpectreTuff: key and tick subscriptions, terminal setup, rendering and exit handling.</Description>
    <PackageTags>tui cli commandline console-application spectre spectre.tui elmish mvu FSharp F#</PackageTags>
    <PackageReleaseNotes>Initial release</PackageReleaseNotes>
    <PackageId>EluciusFTW.SpectreTuff.Elmish</PackageId>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageProjectUrl>https://github.com/EluciusFTW/SpectreTuff</PackageProjectUrl>
    <RepositoryUrl>https://github.com/EluciusFTW/SpectreTuff</RepositoryUrl>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <RepositoryType>git</RepositoryType>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\spectretuff\SpectreTuff.fsproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Elmish" Version="5.0.2" />
    <PackageReference Include="Nerdbank.Gitversioning" Version="3.9.50">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
  </ItemGroup>

  <ItemGroup>
    <None Include="..\..\README.md" Pack="true" PackagePath="\" />
  </ItemGroup>

  <ItemGroup>
    <Compile Include="Subscriptions.fs" />
    <Compile Include="Tui.fs" />
  </ItemGroup>
</Project>
