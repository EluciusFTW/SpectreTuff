<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>SpectreTuff.Cli</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\spectretuff\SpectreTuff.fsproj" />
    <ProjectReference Include="..\spectretuff-elmish\SpectreTuff.Elmish.fsproj" />
  </ItemGroup>

  <ItemGroup>
   <PackageReference Include="Elmish" Version="5.0.2" />
  </ItemGroup>

  <ItemGroup>
    <Compile Include="ListWidget.fs" />
    <Compile Include="Counter.fs" />
    <Compile Include="Log.fs" />
    <Compile Include="Timer.fs" />
    <Compile Include="Application.fs" />
    <Compile Include="Program.fs" />
  </ItemGroup>

</Project>
